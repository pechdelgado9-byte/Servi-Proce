# =============================================================================
# SERVI PROCE — VARIABLES DE ENTORNO PARA PRODUCCIÓN / CPANEL (.env.example)
# Dominio: serviproce.com.mx | Hosting: cPanel (CloudLinux 8 LVE)
# =============================================================================

# 1. Entorno de Ejecución
NODE_ENV=production
# El puerto principal lo asigna automáticamente Phusion Passenger en cPanel (process.env.PORT)
PORT=3000
# Puerto interno para el Backend Headless (si está ocupado en servidor compartido, server.js busca uno libre)
BACKEND_PORT=1337

# 2. URLs Base del Ecosistema
FRONTEND_URL=https://serviproce.com.mx, https://www.serviproce.com.mx
NEXT_PUBLIC_SITE_URL=https://serviproce.com.mx
NEXT_PUBLIC_API_URL=/api/backend
TRUST_PROXY=true

# 3. Seguridad y Autenticación del CMS
JWT_SECRET=sp_jwt_secret_serviproce_production_2026_secure_key
ADMIN_PASSWORD=ServiProce2026!
WEBHOOK_SECRET=sp_webhook_ssg_secret_2026

# 4. Configuración de Correo Electrónico (SMTP Corporativo cPanel)
# Se obtiene en cPanel -> "Cuentas de correo electrónico" -> "Connect Devices / Configurar cliente"
SMTP_HOST=mail.serviproce.com.mx
SMTP_PORT=465
SMTP_USER=customerservice@serviproce.com.mx
SMTP_PASS=tu_contraseña_aqui
SMTP_FROM="Servi Proce <customerservice@serviproce.com.mx>"

# Destinatarios de notificaciones comerciales de cotización:
SALES_EMAIL=customerservice@serviproce.com.mx, jorgebarrios@serviproce.com.mx
OPERATIVE_EMAIL=customerservice@serviproce.com.mx

# 5. Base de Datos (Opcional)
# Por defecto se utiliza SQLite embebido en backend/database/serviproce.sqlite (cero configuración externa)
# Si en el futuro se utiliza PostgreSQL externo en cPanel:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://usuario:password@localhost:5432/serviproce_db

