{
  "name": "servi-proce-ecosystem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "description": "Plataforma Web Headless Servi Proce (Logística y Aduanas) - 100% Apegada al ERS",
  "scripts": {
    "start": "node server.js",
    "postinstall": "node -e \"const {execSync}=require('child_process');const cmd=process.platform==='win32'?'npm.cmd':'npm';execSync(cmd+' --prefix backend install --omit=dev',{stdio:'inherit'});execSync(cmd+' --prefix frontend install',{stdio:'inherit'});\"",
    "build": "npm --prefix frontend run build",
    "dev": "node start-all.mjs",
    "dev:public": "node start-all.mjs --tunnel",
    "demo:public": "node start-all.mjs --prod --tunnel",
    "tunnel": "node start-all.mjs --only-tunnel",
    "dev:backend": "node --watch backend/src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "node --test --test-concurrency=1 backend/tests/hito1.test.js backend/tests/hito2.test.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  }
}
