1b:["$","div",null,{"className":"container relative z-10","children":["$","$L2e",null,{"lang":"en","items":[{"id":"clasificacion","title":"Tariff classification","includes":"Determination of the correct tariff code and NICO for each product.","benefit":"Avoids overpaying duties or fines for misclassification.","image":"https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=1200&auto=format&fit=crop"},{"id":"nom","title":"NOM compliance","includes":"Review of applicable standards, labeling, statements and certificates.","benefit":"Your goods are not held at customs for lack of compliance.","image":"https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=1200&auto=format&fit=crop"},{"id":"regulaciones","title":"Non-tariff regulations and restrictions","includes":"Permits, automatic notices, quotas and requirements from other agencies (SE, SADER, COFEPRIS, SEMARNAT).","benefit":"Procedures are identified at quote time, not once the cargo has already arrived.","image":"https://images.unsplash.com/photo-1521791136064-7986c2920216?q=80&w=1200&auto=format&fit=crop"},{"id":"immex","title":"IMMEX and PROSEC programs","includes":"Advice to obtain, maintain and operate under them.","benefit":"Deferral or reduction of tariffs and VAT on inputs.","image":"https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=1200&auto=format&fit=crop"},{"id":"tlc","title":"Free trade agreements and rules of origin","includes":"Eligibility review (USMCA, EU-Mexico FTA, CPTPP, etc.) and certificates of origin.","benefit":"Preferential or zero tariff.","image":"https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?q=80&w=1200&auto=format&fit=crop"},{"id":"padron","title":"Importers registry and specific sectors","includes":"Registration, updates and reactivation.","benefit":"Prevents suspensions that would halt your operation.","image":"https://images.unsplash.com/photo-1589829545856-d10d557cf95f?q=80&w=1200&auto=format&fit=crop"},{"id":"planeacion","title":"Import and export planning","includes":"Total cost (landed cost) analysis, routes, incoterms and customs regimes.","benefit":"Purchasing decisions backed by clear numbers before you close with the supplier.","image":"https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1200&auto=format&fit=crop"},{"id":"custom-broker","title":"US Customs Broker","includes":"Document preparation, tax calculation and payment, and communication between US authorities and the Mexican exporter.","benefit":"A single partner to comply on both sides of the border.","image":"https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=1200&auto=format&fit=crop"},{"id":"seguros","title":"Cargo insurance","includes":"Coverage of your product’s risks during transit.","benefit":"Your goods travel protected.","image":"https://images.unsplash.com/photo-1578575437130-527eed3abbec?q=80&w=1200&auto=format&fit=crop"},{"id":"adicionales","title":"Additional services","includes":"Transport, storage, distribution and comprehensive supply chain solutions.","benefit":"We cover the whole chain with a single provider.","image":"https://images.unsplash.com/photo-1587293852726-70cdb56c2866?q=80&w=1200&auto=format&fit=crop"}]}]}]
