1b:["$","div",null,{"className":"container relative z-10","children":["$","$L2e",null,{"lang":"es","items":[{"id":"clasificacion","title":"Clasificación arancelaria","includes":"Determinación de la fracción arancelaria y NICO correcta para cada producto.","benefit":"Evita pagar impuestos de más o multas por clasificación errónea.","image":"https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=1200&auto=format&fit=crop"},{"id":"nom","title":"Cumplimiento de NOM","includes":"Revisión de normas aplicables, etiquetado, constancias y certificados.","benefit":"La mercancía no se detiene en aduana por falta de cumplimiento.","image":"https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=1200&auto=format&fit=crop"},{"id":"regulaciones","title":"Regulaciones y restricciones no arancelarias","includes":"Permisos, avisos automáticos, cupos y requisitos de otras dependencias (SE, SADER, COFEPRIS, SEMARNAT).","benefit":"Se identifican los trámites desde la cotización, no cuando la carga ya llegó.","image":"https://images.unsplash.com/photo-1521791136064-7986c2920216?q=80&w=1200&auto=format&fit=crop"},{"id":"immex","title":"Programas IMMEX y PROSEC","includes":"Asesoría para obtenerlos, mantenerlos y operar bajo ellos.","benefit":"Diferimiento o reducción de aranceles e IVA en insumos.","image":"https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?q=80&w=1200&auto=format&fit=crop"},{"id":"tlc","title":"Tratados de libre comercio y reglas de origen","includes":"Revisión de elegibilidad (T-MEC, TLCUE, CPTPP, etc.) y certificados de origen.","benefit":"Arancel preferencial o cero.","image":"https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?q=80&w=1200&auto=format&fit=crop"},{"id":"padron","title":"Padrón de importadores y sectores específicos","includes":"Inscripción, actualización y reactivación.","benefit":"Evita suspensiones que paralicen la operación.","image":"https://images.unsplash.com/photo-1589829545856-d10d557cf95f?q=80&w=1200&auto=format&fit=crop"},{"id":"planeacion","title":"Planeación de importación y exportación","includes":"Análisis de costos totales (landed cost), rutas, incoterms y regímenes.","benefit":"Decisiones de compra con números claros antes de cerrar con el proveedor.","image":"https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1200&auto=format&fit=crop"},{"id":"custom-broker","title":"Custom Broker Americano","includes":"Preparación de documentos, cálculo y pago de impuestos, y comunicación entre las autoridades estadounidenses y el exportador mexicano.","benefit":"Un solo aliado para cumplir en ambos lados de la frontera.","image":"https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=1200&auto=format&fit=crop"},{"id":"seguros","title":"Seguros de carga","includes":"Cobertura de riesgos de su producto durante el traslado.","benefit":"Su mercancía viaja protegida.","image":"https://images.unsplash.com/photo-1578575437130-527eed3abbec?q=80&w=1200&auto=format&fit=crop"},{"id":"adicionales","title":"Servicios adicionales","includes":"Transporte, almacenaje, distribución y soluciones integrales en la cadena de suministro.","benefit":"Cubrimos la cadena completa con un solo proveedor.","image":"https://images.unsplash.com/photo-1587293852726-70cdb56c2866?q=80&w=1200&auto=format&fit=crop"}]}]}]
