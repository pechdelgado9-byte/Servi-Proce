# ============================================================================
# SERVI PROCE - CONFIGURACIÓN DE ENTORNO DEL BACKEND (Sección 2.1.9.2 del ERS)
# ============================================================================

# Puerto del servidor Backend / CMS Headless
PORT=1337
NODE_ENV=development

# Base de Datos PostgreSQL (En tu laptop con Docker activa esta línea;
# si está vacía o PostgreSQL no responde, usa automáticamente SQLite embebido con Prepared Statements)
# DATABASE_URL=postgresql://serviproce:serviproce_secret_2026@localhost:5432/serviproce_cms
DATABASE_URL=

# Claves Criptográficas de Seguridad (Sección 2.1.9.2 y RF-07)
APP_KEYS=sp_app_key_primary_2026,sp_app_key_secondary_2026
JWT_SECRET=sp_jwt_hmac_sha256_secret_key_2026_serviproce

# Credenciales del SuperAdmin inicial (Sección 2.1.9.1)
ADMIN_USERNAME=admin@serviproce.com.mx
ADMIN_PASSWORD=ServiProce2026!

# Políticas de Seguridad CORS y Webhook SSG (Sección 2.1.9.2 y RF-07)
FRONTEND_URL=http://localhost:3000
FRONTEND_WEBHOOK_URL=http://localhost:3000/api/revalidate
WEBHOOK_SECRET=sp_webhook_ssg_secret_2026

# Google reCAPTCHA v2/v3 (RF-04 - dejar vacío en desarrollo local para bypass controlado)
RECAPTCHA_SECRET_KEY=

# Servidor de Correo Transaccional SMTP (RF-01 - Puertos seguros 465 o 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sitio Web Servi Proce <noreply@serviproce.com.mx>"
SALES_EMAIL=customerservice@serviproce.com.mx,jorgebarrios@serviproce.com.mx
