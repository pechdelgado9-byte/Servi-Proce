# =========================================================================
# SERVIPROCE BACKEND - VARIABLES DE ENTORNO (.env.example)
# =========================================================================

NODE_ENV=development
PORT=1337
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false

# Base de datos (PostgreSQL en producción / SQLite o PostgreSQL en desarrollo)
DB_DRIVER=postgres
DATABASE_URL=postgres://serviproce:serviproce_secret_dev@localhost:5433/serviproce_db

# Seguridad y Autenticación (Reemplazar en producción por valores criptográficos aleatorios)
JWT_SECRET=REEMPLAZAR_POR_SECRETO_HMAC_SHA256_DE_AL_MENOS_32_BYTES
ADMIN_PASSWORD=REEMPLAZAR_POR_CONTRASENA_SEGURA
WEBHOOK_SECRET=REEMPLAZAR_POR_SECRETO_DE_SINCRONIZACION_ISR

# Correo Electrónico Operativo y SMTP
OPERATIVE_EMAIL=cotizaciones@serviproce.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google reCAPTCHA v3
RECAPTCHA_SECRET_KEY=
