# =========================================================================
# SERVIPROCE BACKEND - VARIABLES DE ENTORNO (.env.example)
# =========================================================================

NODE_ENV=development
PORT=1337
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false

# Base de datos (PostgreSQL en producción / SQLite o PostgreSQL en desarrollo)
DB_DRIVER=postgres
DATABASE_URL=postgres://serviproce:serviproce_secret_dev@localhost:5433/serviproce_db

# Seguridad y Autenticación (Reemplazar en producción por valores criptográficos aleatorios)
JWT_SECRET=REEMPLAZAR_POR_SECRETO_HMAC_SHA256_DE_AL_MENOS_32_BYTES
ADMIN_PASSWORD=REEMPLAZAR_POR_CONTRASENA_SEGURA
WEBHOOK_SECRET=REEMPLAZAR_POR_SECRETO_DE_SINCRONIZACION_ISR

# Correo Electrónico Operativo y SMTP (Servidor cPanel / Servidor de Correo Corporativo)
# Destinatarios de las notificaciones comerciales (ambos directivos reciben cada cotización):
SALES_EMAIL=customerservice@serviproce.com.mx, jorgebarrios@serviproce.com.mx
OPERATIVE_EMAIL=customerservice@serviproce.com.mx

# Datos de Conexión SMTP (Obtener en cPanel -> "Cuentas de correo electrónico" -> "Connect Devices / Configurar cliente")
# Hostname habitual en cPanel: mail.serviproce.com.mx (o el nombre del servidor, ej. olimpo.host...)
SMTP_HOST=mail.serviproce.com.mx
# Puerto habitual: 465 (SSL/TLS) o 587 (STARTTLS)
SMTP_PORT=465
# Usuario de autenticación (Dirección de correo completa creada en cPanel)
SMTP_USER=cotizaciones@serviproce.com.mx
# Contraseña asignada a la cuenta de correo en cPanel
SMTP_PASS=tu_contraseña_aqui
# Remitente mostrado (debe coincidir o pertenecer al mismo dominio que SMTP_USER para pasar SPF/DKIM)
SMTP_FROM="Servi Proce Cotizaciones <cotizaciones@serviproce.com.mx>"

# Google reCAPTCHA v3
RECAPTCHA_SECRET_KEY=
