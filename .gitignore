# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/node_modules
backend/node_modules/
frontend/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js cache and dev (el build de producción .next se incluye para cPanel)
.next/cache/
.next/dev/
frontend/.next/cache/
frontend/.next/dev/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (ERS Section 2.1.9.2: never commit .env credentials, only .env.example)
.env
.env*.local
backend/.env
frontend/.env
frontend/.env.local
!*.env.example
!.env.example

# backend local runtime database & uploads
backend/database/*.sqlite*
backend/database/*.json*
backend/database/mail_outbox/
backend/database/cotizaciones/
backend/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
subir_a_github.bat
